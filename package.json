{
  "name": "food-app",
  "private": true,
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta npm:dev:backend npm:dev:frontend",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "build": "npm install --prefix backend && npm install --prefix frontend && npm run build --prefix frontend && node scripts/copy-frontend.mjs",
    "start": "npm start --prefix backend"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
